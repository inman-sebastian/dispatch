# --- oMLX (local inference, OpenAI-compatible) ---
# Check your oMLX admin panel for the actual port. Common values: 8000, 18000.
OMLX_BASE_URL=http://127.0.0.1:8000/v1
# Model alias or directory name as shown in oMLX /v1/models.
# Default: Qwen3-Coder-30B-A3B — MoE with 3B active params, fast and strong at
# constrained rewriting (instruction briefs). Quality alternative you already
# have: Qwen3.8-27B-MLX-4bit.
OMLX_MODEL=Qwen3-Coder-30B-A3B-Instruct-MLX-4bit

# --- Decision API (Jev-compatible shape) ---
# Default: TypeSafe Jev cloud. Create a key at https://console.typesafe.ai
# Alternative: self-hosted Laya -> run `laya-serve` and point here
# (e.g. http://127.0.0.1:8001/v1/systemone ; laya-serve ignores DECISION_MODEL).
DECISION_API_URL=https://api.typesafe.ai/v1/systemone
DECISION_API_KEY=
# Model id sent with each decision request.
DECISION_MODEL=jev-latest

# --- Behavior ---
# Max characters of enriched state sent to the decision API.
STATE_CHAR_BUDGET=6000
# Below this confidence, model_tier is escalated one level (local->cheap->flagship).
CONFIDENCE_THRESHOLD=0.6
# Below this task_type confidence, the harness asks you to confirm the intent
# instead of guessing (TypeSafe intent-routing pattern).
INTENT_CLARIFY_THRESHOLD=0.5
# Ask for confirmation when P(destructive) reaches this. Gates on the raw
# probability, not the boolean: a 0.49 coin-flip still confirms.
DESTRUCTIVE_CONFIRM_PROBABILITY=0.25
# JSONL log of every decision + outcome. This becomes your fine-tuning dataset later.
DECISION_LOG_PATH=./decisions.jsonl
# Set to 1 to skip interactive confirmations (gates + destructive ops).
AUTO_APPROVE_GATES=0
AUTO_APPROVE_DESTRUCTIVE=0
